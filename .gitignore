# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Datasets (never commit raw or processed data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Experiment outputs: the measured N-BaIoT results (metrics, configs, logs, comparison
# figures) are committed as evidence; weights, score dumps and per-run figures are not.
results/experiments/*/figures/
results/experiments/*/scores_*.npz
results/synthetic/
results/ui/
results/probe/*/scores_*.npz
results/notebook_figures/

# Model artefacts
*.pt
*.pth
*.joblib

# Secrets / local config
.env
*.key
*.pem

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
